{
  "name": "@taskfile/desktop",
  "productName": "Taskfile",
  "version": "0.1.0",
  "private": true,
  "description": "Taskfile desktop app (Electron wrapper around the web app)",
  "author": "Darrien Rushing <drushing.dev@gmail.com>",
  "type": "module",
  "main": "dist/main.mjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "dev": "node scripts/build.mjs && electron .",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "package": "npm run build && electron-builder --dir --publish never -c.mac.identity=null",
    "dist": "npm run build && electron-builder --publish never",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "45.0.0",
    "electron-builder": "^26.17.0",
    "electron-updater": "^6.8.11",
    "esbuild": "^0.28.2",
    "srvx": "^1.0.7",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
