{
  "name": "taskfile-monorepo",
  "private": true,
  "description": "Taskfile monorepo: the CLI/TUI (apps/cli) and the web app (apps/web)",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "dev:cli": "npm run dev -w @rushinglabs/taskfile --",
    "dev:web": "npm run dev -w @taskfile/web",
    "installers": "npm run installers -w @rushinglabs/taskfile --"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
